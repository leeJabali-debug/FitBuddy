{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "FitBuddy student profile with goals, streak, and academic campus metadata.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "campus": { "type": "string", "maxLength": 100 },
        "major": { "type": "string", "maxLength": 100 },
        "year": { "type": "string", "maxLength": 50 },
        "avatarLetter": { "type": "string", "maxLength": 5 },
        "dailyStepGoal": { "type": "number" },
        "dailyActiveGoal": { "type": "number" },
        "dailyWaterGoal": { "type": "number" },
        "streakCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "dailyStepGoal", "dailyActiveGoal", "dailyWaterGoal"]
    },
    "ActivityItem": {
      "title": "ActivityItem",
      "description": "Logged workout, steps, or campus fitness activity.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 100 },
        "type": { "type": "string", "maxLength": 30 },
        "durationMinutes": { "type": "number" },
        "steps": { "type": "number" },
        "calories": { "type": "number" },
        "timeStr": { "type": "string", "maxLength": 30 },
        "dateStr": { "type": "string", "maxLength": 20 },
        "notes": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "type", "durationMinutes", "timeStr", "dateStr"]
    },
    "GoalItem": {
      "title": "GoalItem",
      "description": "Habit milestone or fitness target for the user.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 100 },
        "current": { "type": "number" },
        "target": { "type": "number" },
        "unit": { "type": "string", "maxLength": 30 },
        "category": { "type": "string", "maxLength": 30 },
        "custom": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "current", "target", "unit", "category"]
    },
    "WaterLogEntry": {
      "title": "WaterLogEntry",
      "description": "Single hydration intake log entry.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "timeStr": { "type": "string", "maxLength": 20 },
        "glasses": { "type": "number" },
        "ml": { "type": "number" },
        "dateStr": { "type": "string", "maxLength": 20 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "timeStr", "glasses", "ml", "dateStr"]
    },
    "BuddyConnection": {
      "title": "BuddyConnection",
      "description": "Status of peer workout partner connection request.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "buddyId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "maxLength": 30 },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "buddyId", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile with goals and campus settings. Accessible only by owner."
    },
    "/users/{userId}/activities/{activityId}": {
      "schema": "ActivityItem",
      "description": "Subcollection of fitness activity logs owned by userId."
    },
    "/users/{userId}/goals/{goalId}": {
      "schema": "GoalItem",
      "description": "Subcollection of fitness targets and habit goals owned by userId."
    },
    "/users/{userId}/waterLogs/{waterLogId}": {
      "schema": "WaterLogEntry",
      "description": "Subcollection of hydration timestamps owned by userId."
    },
    "/users/{userId}/buddyConnections/{buddyId}": {
      "schema": "BuddyConnection",
      "description": "Subcollection tracking peer connection status for userId."
    }
  }
}
